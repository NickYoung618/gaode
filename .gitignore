# Delivered archives/evidence are carried by the migration package, not source Git
/artifacts/
/workcopies/
/device-commissioning-0.1.1-20261003/
*.zip
*.7z
*.bundle
*.zip.sha256*
*.zip.sha256.txt
/gaode-completed-local-test-win-x64-20260926.zip.sha256
