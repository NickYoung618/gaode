          "archiveStartLine": 378,
          "offset": 17162,
          "before": "\r\n      <!-- body: 3 columns -->\r\n      <div class=\"flex-1 min-h-0 p-4 grid gap-4 overflow-hidden\" style=\"grid-template-columns: 380px minmax(0,1fr) minmax(0,1fr);\">\r\n\r\n        <!-- ========== 列 1：基础配置 ========== -->\r\n        <fieldset class=\"hmi-fieldset min-h-0 overflow-y-auto\">\r\n          <legend>基础配置</legend>\r\n\r\n          <div class=\"hmi-row\"><label>产品类型：</label>\r\n            <select class=\"hmi-input\">\r\n              <option>大底座</option><option>压缩端盖</option><option>转子外罩</option>\r\n              <option>电机外壳</option><option>杜瓦</option><option>冷指保护筒</option>\r\n              <option>阀钉</option><option>半成品</option>\r\n            </select>\r\n          </div>\r\n          <div class=\"hmi-row\"><label>单配方产品个数：</label><input class=\"hmi-input\" type=\"number\" value=\"1\" /></div>\r\n          <div class=\"hmi-row\"><label>内部产品编码：</label><input class=\"hmi-input\" value=\"PRD-DDZ-001\" readonly /></div>\r\n          <div class=\"hmi-row\"><label>配方 ID：</label><input class=\"hmi-input\" value=\"RCP-20260422-001\" readonly /></div>\r\n\r\n          <div class=\"hmi-sep\"></div>\r\n\r\n          <div class=\"hmi-row\"><label>MES 批次号：</label><input class=\"hmi-input\" value=\"B26042103\" /></div>\r\n          <div class=\"hmi-row\"><label>MES 工单号：</label><input class=\"hmi-input\" value=\"MO-917245\" /></div>\r\n          <div class=\"hmi-row\"><label>MES 接口：</label><input class=\"hmi-input\" value=\"http://mes.local/api/lot\" /></div>\r\n\r\n          <div class=\"hmi-sep\"></div>\r\n\r\n          <div class=\"hmi-row\"><label>检测场景：</label>\r\n            <select class=\"hmi-input\">\r\n              <option>单一零件检测</option>\r\n              <option selected>半成品检测</option>\r\n              <option>成品检测</option>\r\n            </select>\r\n          </div>\r\n\r\n          <div class=\"hmi-sep\"></div>\r\n\r\n          <div class=\"hmi-row\"><label>识别 LotId：</label>\r\n            <div class=\"flex items-center gap-4\">\r\n              <label class=\"flex items-center gap-1 text-sm\"><input type=\"radio\" name=\"lot\" checked /> 需要</label>\r\n              <label class=\"flex items-center gap-1 text-sm\"><input type=\"radio\" name=\"lot\" /> 不需要</label>\r\n            </div>\r\n          </div>\r\n          <div class=\"hmi-row\"><label>编码类型：</label>\r\n            <select class=\"hmi-input\"><option>二维码 QR</option><option>一维码</option><option>DataMatrix</option></select>\r\n          </div>\r\n          <div class=\"hmi-row\"><label>匹配正则：</label><input class=\"hmi-input\" value=\"^[A-Z]{3}-\\\\d{6}$\" /></div>\r\n\r\n          <div class=\"hmi-sep\"></div>\r\n\r\n          <div class=\"hmi-row\"><label>翻面检测 isNeedFlip：</label>\r\n            <div class=\"flex items-center gap-4\">\r\n              <label class=\"flex items-center gap-1 text-sm\"><input id=\"flipToggle\" type=\"checkbox\" checked /> true</label>\r\n            </div>\r\n          </div>\r\n          <div id=\"flipParams\">\r\n            <div class=\"hmi-row\"><label>翻转角度 (°)：</label><input class=\"hmi-input\" type=\"number\" value=\"180\" /></div>\r\n            <div class=\"hmi-row\"><label>翻转速度 (°/s)：</label><input class=\"hmi-input\" type=\"number\" value=\"90\" /></div>\r\n            <div class=\"hmi-row\"><label>定位精度 (mm)：</label><input class=\"hmi-input\" type=\"number\" value=\"0.05\" step=\"0.01\" /></div>\r\n          </div>\r\n        </fieldset>\r\n\r\n        <!-- ========== 列 2：硬件 / 对焦 / 位置 ========== -->\r\n        <fieldset class=\"hmi-fieldset min-h-0 flex flex-col overflow-hidden\">\r\n          <legend>硬件与位置参数</legend>\r\n          <div class=\"flex-1 min-h-0 overflow-y-auto\">\r\n            <table class=\"hmi-table\">\r\n              <thead>\r\n                <tr><th style=\"width:38%;\">参数名称</th><th>值</th></tr>\r\n              </thead>\r\n              <tbody>\r\n                <tr class=\"hmi-tr-hi\"><td colspan=\"2\" class=\"hmi-sub\">相机</td></tr>\r\n                <tr><td>型号 / 通道数</td><td><input class=\"hmi-input\" value=\"HIK MV-CU120-10GM × 4\" /></td></tr>\r\n                <tr><td>曝光 (ms)</td><td><input class=\"hmi-input\" type=\"number\" value=\"12.5\" step=\"0.1\" /></td></tr>\r\n                <tr><td>增益 (dB)</td><td><input class=\"hmi-input\" type=\"number\" value=\"6\" /></td></tr>\r\n                <tr><td>像素比例 (mm/px)</td><td><input class=\"hmi-input\" type=\"number\" value=\"0.01\" step=\"0.001\" /></td></tr>\r\n\r\n                <tr class=\"hmi-tr-hi\"><td colspan=\"2\" class=\"hmi-sub\">光源</td></tr>\r\n                <tr><td>模式</td><td><select class=\"hmi-input\"><option>同轴</option><option>环形</option><option>条形</option><option>多光源联动</option></select></td></tr>\r\n                <tr><td>通道数</td><td><input class=\"hmi-input\" type=\"number\" value=\"8\" /></td></tr>\r\n                <tr><td>强度 (%)</td><td><input class=\"hmi-input\" type=\"number\" value=\"75\" /></td></tr>\r\n                <tr><td>色温 (K)</td><td><input class=\"hmi-input\" type=\"number\" value=\"6500\" /></td></tr>\r\n\r\n                <tr class=\"hmi-tr-hi\"><td colspan=\"2\" class=\"hmi-sub\">PLC</td></tr>\r\n                <tr><td>型号</td><td><input class=\"hmi-input\" value=\"西门子 S7-1200\" /></td></tr>\r\n                <tr><td>IP : Port</td><td><input class=\"hmi-input\" value=\"10.1.1.50:502\" /></td></tr>\r\n                <tr><td>节拍 (s)</td><td><input class=\"hmi-input\" type=\"number\" value=\"1.8\" step=\"0.1\" /></td></tr>\r\n\r\n                <tr class=\"hmi-tr-hi\"><td colspan=\"2\" class=\"hmi-sub\">自动对焦</td></tr>\r\n                <tr><td>对焦模式</td><td><select class=\"hmi-input\"><option>自动</option><option>手动</option></select></td></tr>\r\n                <tr><td>对焦范围 (mm)</td><td><input class=\"hmi-input\" type=\"number\" value=\"5.0\" step=\"0.1\" /></td></tr>\r\n                <tr><td>对焦步长 (mm)</td><td><input class=\"hmi-input\" type=\"number\" value=\"0.05\" step=\"0.01\" /></td></tr>\r\n\r\n                <tr class=\"hmi-tr-hi\