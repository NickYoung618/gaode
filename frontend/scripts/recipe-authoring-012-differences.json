1px solid rgba(148,163,184,.12);font-size:14px;color:#cbd5e1; }\r\n  .recipe-authoring .recipe-note { font-size:12px!important;color:#94a3b8!important;line-height:1.8; }\r\n  .recipe-authoring .recipe-editor-layout { display:grid;grid-template-columns:190px 235px minmax(0,1fr);gap:12px;min-height:440px; }\r\n  .recipe-authoring .recipe-nav, .recipe-authoring .recipe-slots { padding:14px; }\r\n  .recipe-authoring .recipe-nav-button { display:block;width:100%;margin:0 0 10px;text-align:left;padding:10px;font-size:12px;height:auto; }\r\n  .recipe-authoring .active { border-color:rgba(34,211,238,.6);background:rgba(6,182,212,.13);color:#a5f3fc; }\r\n  .recipe-authoring .recipe-face-rail, .recipe-authoring .recipe-camera-pair { display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-bottom:18px;font-size:12px; }\r\n  .recipe-authoring .recipe-point-card { border:1px solid rgba(148,163,184,.2);border-radius:8px;padding:15px;background:rgba(15,23,42,.5); }\r\n  .recipe-authoring .recipe-point-card .recipe-input { display:flex;flex-direction:column;align-items:stretch;gap:5px;margin:0; }\r\n  .recipe-authoring .recipe-axis-fields { display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin-top:12px; }\r\n  .recipe-authoring .recipe-axis-fields .recipe-input:last-child { grid-column:1/-1; }\r\n  .recipe-authoring .recipe-capture-fields { display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;margin-top:12px; }\r\n  .recipe-authoring .recipe-editor-footer { display:flex;justify-content:flex-end;gap:12px;margin-top:14px; }\r\n  .recipe-authoring .recipe-review-table { width:100%;border-collapse:collapse;font-size:13px; }\r\n  .recipe-authoring .recipe-review-table th, .recipe-authoring .recipe-review-table td { padding:14px 8px;border-bottom:1px solid rgba(148,163,184,.18);text-align:left; }\r\n  .recipe-authoring .recipe-issue { padding:10px 0;color:#fda4af;font-size:13px; }\r\n  .recipe-authoring .recipe-editor-layout { grid-template-column