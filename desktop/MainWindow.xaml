<Window x:Class="Gaode.Station01.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="制冷机零件缺陷检测系统" Width="1600" Height="900" WindowStartupLocation="CenterScreen">
  <Grid Background="#111827">
    <WebView2 x:Name="Browser" xmlns="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf" />
    <Border x:Name="HostError" Visibility="Collapsed" Background="#111827" Padding="32">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock x:Name="HostErrorTitle" Foreground="White" FontSize="24" TextAlignment="Center" />
        <TextBlock x:Name="HostErrorDetails" Foreground="#cbd5e1" FontSize="14" Margin="0,16,0,0" TextWrapping="Wrap" MaxWidth="720" TextAlignment="Center" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
