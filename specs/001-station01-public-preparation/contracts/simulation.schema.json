{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Station01 In-process Simulation Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "purpose",
    "source",
    "clockMode",
    "virtualStartUtc",
    "publicConfigRef",
    "budgetRef",
    "stages",
    "deviceInitial",
    "stop",
    "lateObservationWindowMs",
    "fixtures"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "const": "Test",
      "description": "Simulation evidence is test-only and cannot be presented as real PLC acceptance."
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "description": "Use Simulated for in-process SimulatedPlc or Virtual for the independent VirtualPlc process."
    },
    "clockMode": {
      "enum": [
        "RealElapsed",
        "Controlled"
      ]
    },
    "virtualStartUtc": {
      "type": "string",
      "format": "date-time"
    },
    "publicConfigRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "budgetRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "stages": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plcAcceptance",
        "clampCompletion",
        "xyCompletion",
        "capture3d",
        "heightAlgorithm",
        "captureF",
        "fDecode"
      ],
      "properties": {
        "plcAcceptance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "delayMs",
            "strategy",
            "outcome",
            "failureCode",
            "duplicateOffsetsMs",
            "ignoreCancel"
          ],
          "properties": {
            "delayMs": {
              "type": "integer",
              "minimum": 0
            },
            "strategy": {
              "enum": [
                "Respond",
                "Fail",
                "NoResponse"
              ]
            },
            "outcome": {
              "enum": [
                "Success",
                "Failure",
                "Hold"
              ]
            },
            "failureCode": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "duplicateOffsetsMs": {
              "type": "array",
              "maxItems": 4,
              "items": {
                "type": "integer",
                "minimum": 1
              }
            },
            "ignoreCancel": {
              "type": "boolean"
            }
          }
        },
        "clampCompletion": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "delayMs",
            "strategy",
            "outcome",
            "failureCode",
            "duplicateOffsetsMs",
            "ignoreCancel"
          ],
          "properties": {
            "delayMs": {
              "type": "integer",
              "minimum": 0
            },
            "strategy": {
              "enum": [
                "Respond",
                "Fail",
                "NoResponse"
              ]
            },
            "outcome": {
              "enum": [
                "Success",
                "Failure",
                "Hold"
              ]
            },
            "failureCode": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "duplicateOffsetsMs": {
              "type": "array",
              "maxItems": 4,
              "items": {
                "type": "integer",
                "minimum": 1
              }
            },
            "ignoreCancel": {
              "type": "boolean"
            }
          }
        },
        "xyCompletion": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "delayMs",
            "strategy",
            "outcome",
            "failureCode",
            "duplicateOffsetsMs",
            "ignoreCancel"
          ],
          "properties": {
            "delayMs": {
              "type": "integer",
              "minimum": 0
            },
            "strategy": {
              "enum": [
                "Respond",
                "Fail",
                "NoResponse"
              ]
            },
            "outcome": {
              "enum": [
                "Success",
                "Failure",
                "Hold"
              ]
            },
            "failureCode": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "duplicateOffsetsMs": {
              "type": "array",
              "maxItems": 4,
              "items": {
                "type": "integer",
                "minimum": 1
              }
            },
            "ignoreCancel": {
              "type": "boolean"
            }
          }
        },
        "capture3d": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "delayMs",
            "strategy",
            "outcome",
            "failureCode",
            "duplicateOffsetsMs",
            "ignoreCancel"
          ],
          "properties": {
            "delayMs": {
              "type": "integer",
              "minimum": 0
            },
            "strategy": {
              "enum": [
                "Respond",
                "Fail",
                "NoResponse"
              ]
            },
            "outcome": {
              "enum": [
                "Success",
                "Failure",
                "Hold"
              ]
            },
            "failureCode": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "duplicateOffsetsMs": {
              "type": "array",
              "maxItems": 4,
              "items": {
                "type": "integer",
                "minimum": 1
              }
            },
            "ignoreCancel": {
              "type": "boolean"
            }
          }
        },
        "heightAlgorithm": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "delayMs",
            "strategy",
            "outcome",
            "failureCode",
            "duplicateOffsetsMs",
            "ignoreCancel"
          ],
          "properties": {
            "delayMs": {
              "type": "integer",
              "minimum": 0
            },
            "strategy": {
              "enum": [
                "Respond",
                "Fail",
                "NoResponse"
              ]
            },
            "outcome": {
              "enum": [
                "Success",
                "Failure",
                "Hold"
              ]
            },
            "failureCode": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "duplicateOffsetsMs": {
              "type": "array",
              "maxItems": 4,
              "items": {
                "type": "integer",
                "minimum": 1
              }
            },
            "ignoreCancel": {
              "type": "boolean"
            }
          }
        },
        "captureF": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "delayMs",
            "strategy",
            "outcome",
            "failureCode",
            "duplicateOffsetsMs",
            "ignoreCancel"
          ],
          "properties": {
            "delayMs": {
              "type": "integer",
              "minimum": 0
            },
            "strategy": {
              "enum": [
                "Respond",
                "Fail",
                "NoResponse"
              ]
            },
            "outcome": {
              "enum": [
                "Success",
                "Failure",
                "Hold"
              ]
            },
            "failureCode": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "duplicateOffsetsMs": {
              "type": "array",
              "maxItems": 4,
              "items": {
                "type": "integer",
                "minimum": 1
              }
            },
            "ignoreCancel": {
              "type": "boolean"
            }
          }
        },
        "fDecode": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "delayMs",
            "strategy",
            "outcome",
            "failureCode",
            "duplicateOffsetsMs",
            "ignoreCancel"
          ],
          "properties": {
            "delayMs": {
              "type": "integer",
              "minimum": 0
            },
            "strategy": {
              "enum": [
                "Respond",
                "Fail",
                "NoResponse"
              ]
            },
            "outcome": {
              "enum": [
                "Success",
                "Failure",
                "Hold"
              ]
            },
            "failureCode": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "duplicateOffsetsMs": {
              "type": "array",
              "maxItems": 4,
              "items": {
                "type": "integer",
                "minimum": 1
              }
            },
            "ignoreCancel": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "deviceInitial": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "connected",
        "automatic",
        "safetyClear",
        "clamped",
        "x",
        "y"
      ],
      "properties": {
        "connected": {
          "type": "boolean"
        },
        "automatic": {
          "type": "boolean"
        },
        "safetyClear": {
          "type": "boolean"
        },
        "clamped": {
          "const": false
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      }
    },
    "stop": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "acceptedDelayMs",
        "completedDelayMs",
        "respond"
      ],
      "properties": {
        "acceptedDelayMs": {
          "type": "integer",
          "minimum": 0
        },
        "completedDelayMs": {
          "type": "integer",
          "minimum": 0
        },
        "respond": {
          "type": "boolean"
        }
      }
    },
    "lateObservationWindowMs": {
      "type": "integer",
      "minimum": 1
    },
    "fixtures": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "heightSamples",
        "rawCodes",
        "mediaSource"
      ],
      "properties": {
        "heightSamples": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sourceElementId",
              "value",
              "unit",
              "datum"
            ],
            "properties": {
              "sourceElementId": {
                "type": "string",
                "minLength": 1
              },
              "value": {
                "type": "number"
              },
              "unit": {
                "const": "mm"
              },
              "datum": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "rawCodes": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "mediaSource": {
          "const": "SyntheticTestFixture"
        }
      }
    }
  }
}
